# FE local environment
# If VITE_API_BASE_URL is left empty, axios will use relative /api paths
# and Vite dev server will proxy them to VITE_DEV_PROXY_TARGET.

# Optional direct API base URL, for example:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=

# Optional direct WebSocket base URL for chat, for example:
# VITE_WS_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=

# Optional Vite proxy target used during local development.
# Default in vite.config.ts is http://localhost:8080 when this value is empty.
VITE_DEV_PROXY_TARGET=http://localhost:8080
