        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% --- USER MANAGEMENT ---\n    USERS {\n        uuid id PK\n        string email \&quot;Unique\&quot;\n        string password_hash\n        string first_name\n        string last_name\n        string role \&quot;Enum: guest, buyer, seller...\&quot;\n        string status\n        boolean is_verified\n    }\n\n    %% --- LOOKUP TABLES (NEW) ---\n    BRAKE_TYPES {\n        uuid id PK\n        string name \&quot;Unique\&quot;\n        string description\n    }\n\n    FRAME_MATERIALS {\n        uuid id PK\n        string name \&quot;Unique\&quot;\n        string description\n    }\n\n    BRANDS {\n        uuid id PK\n        string name\n        string logo_url\n    }\n\n    CATEGORIES {\n        uuid id PK\n        string name\n        string slug\n        uuid parent_id FK\n    }\n\n    %% --- MAIN PRODUCT ---\n    PRODUCTS {\n        uuid id PK\n        uuid seller_id FK\n        uuid brand_id FK\n        uuid category_id FK\n        uuid brake_type_id FK\n        uuid frame_material_id FK\n        string title\n        decimal price\n        string condition \&quot;Enum\&quot;\n        string status\n    }\n\n    %% --- RELATED DATA ---\n    PRODUCT_IMAGES {\n        uuid id PK\n        uuid product_id FK\n        string url\n        boolean is_primary\n    }\n\n    WISHLISTS {\n        uuid user_id PK, FK\n        uuid product_id PK, FK\n        timestamp created_at\n    }\n\n    INSPECTIONS {\n        uuid id PK\n        uuid product_id FK\n        uuid inspector_id FK\n        decimal overall_score\n        boolean passed\n    }\n\n    %% --- ORDER &amp; TRANSACTION ---\n    ORDERS {\n        uuid id PK\n        uuid buyer_id FK\n        uuid seller_id FK\n        uuid product_id FK\n        decimal total_amount\n        string status \&quot;Enum\&quot;\n        string payment_method\n    }\n\n    REVIEWS {\n        uuid id PK\n        uuid order_id FK\n        uuid reviewer_id FK\n        uuid reviewee_id FK\n        int rating\n        string comment\n    }\n\n    %% --- COMMUNICATION ---\n    CONVERSATIONS {\n        uuid id PK\n        uuid product_id FK\n        uuid buyer_id FK\n        uuid seller_id FK\n    }\n\n    MESSAGES {\n        uuid id PK\n        uuid conversation_id FK\n        uuid sender_id FK\n        string content\n    }\n\n    REPORTS {\n        uuid id PK\n        uuid reporter_id FK\n        uuid target_id\n        string target_type\n        string reason\n    }\n\n    %% --- RELATIONSHIPS ---\n\n    %% Users relationships\n    USERS ||--o{ PRODUCTS : \&quot;sells\&quot;\n    USERS ||--o{ ORDERS : \&quot;places (buyer)\&quot;\n    USERS ||--o{ ORDERS : \&quot;receives (seller)\&quot;\n    USERS ||--o{ INSPECTIONS : \&quot;performs (inspector)\&quot;\n    USERS ||--o{ MESSAGES : \&quot;sends\&quot;\n    USERS ||--o{ REVIEWS : \&quot;writes\&quot;\n    USERS ||--o{ REPORTS : \&quot;creates\&quot;\n    USERS ||--o{ WISHLISTS : \&quot;saves\&quot;\n    USERS ||--o{ CONVERSATIONS : \&quot;participates\&quot;\n\n    %% Product relationships\n    PRODUCTS }o--|| BRANDS : \&quot;branded by\&quot;\n    PRODUCTS }o--|| CATEGORIES : \&quot;categorized in\&quot;\n    PRODUCTS }o--|| BRAKE_TYPES : \&quot;equipped with\&quot;\n    PRODUCTS }o--|| FRAME_MATERIALS : \&quot;made of\&quot;\n    PRODUCTS ||--o{ PRODUCT_IMAGES : \&quot;displayed via\&quot;\n    PRODUCTS ||--o{ WISHLISTS : \&quot;saved in\&quot;\n    PRODUCTS ||--o{ INSPECTIONS : \&quot;inspected\&quot;\n    PRODUCTS ||--o{ ORDERS : \&quot;sold in\&quot;\n    PRODUCTS ||--o{ CONVERSATIONS : \&quot;discussed in\&quot;\n\n    %% Category self-reference\n    CATEGORIES |o--o{ CATEGORIES : \&quot;parent of\&quot;\n\n    %% Order flow\n    ORDERS ||--o{ REVIEWS : \&quot;generates\&quot;\n\n    %% Chat flow\n    CONVERSATIONS ||--o{ MESSAGES : \&quot;contains\&quot;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t1pchNvZ46917NmIcbBl-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1916.4000244140625" width="3755.22216796875" x="20" y="1770" as="geometry" />
          </mxCell>
        </UserObject>
